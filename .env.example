DATABASE_URL="file:./prisma/dev.db"
SUPABASE_AUDIO_URL="https://your-supabase-project.supabase.co/storage/v1/object/public/meditations"
JWT_SECRET="change-me-in-production"
REFRESH_SECRET="change-me-in-production"

# Apple App Store Server API — required for /api/subscriptions/verify and /api/subscriptions/notifications
APPLE_BUNDLE_ID="app.ddworks.FocusOnYourself"
APPLE_ROOT_CERTS_DIR="./certs/apple-roots" # directory containing Apple's .cer root certificates from https://www.apple.com/certificateauthority/
# Note: environment (Sandbox/Production/Xcode/LocalTesting) is detected per-request from the JWS payload — no env var needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id              String @id
  title           String
  topic           String
  readTimeMinutes Int
  body            String
}

model MeditationSession {
  id              String           @id
  title           String
  category        String
  durationMinutes Int
  isPro           Boolean
  steps           MeditationStep[]
}

model MeditationStep {
  id                     Int               @id @default(autoincrement())
  order                  Int
  instruction            String?
  silenceDurationSeconds Int?
  sessionId              String
  session                MeditationSession @relation(fields: [sessionId], references: [id])
}

model Affirmation {
  id       Int    @id @default(autoincrement())
  quote    String
  category String
}

model NarrationEntry {
  id          Int    @id @default(autoincrement())
  instruction String @unique
  audioUrl    String
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  checkIns      CheckIn[]
  subscriptions Subscription[]
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId             String
  originalTransactionId String   @unique
  expiresAt             DateTime
  status                String
  environment           String
  lastVerifiedAt        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model CheckIn {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateString          String
  mood                String
  feelingsDescription String?
  sleepQuality        Int?
  stressLevel         Int?
  exercised           Boolean?
  socialQuality       Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, dateString])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
